# Supabase (プロジェクト: puzzliar's Project / wiqnmebudaadwqdaxwko)
NEXT_PUBLIC_SUPABASE_URL=https://wiqnmebudaadwqdaxwko.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Dashboard > Project Settings > API Keys > service_role (秘匿。サーバー専用)
SUPABASE_SERVICE_ROLE_KEY=

# 公開URL (本番: https://ticket.puzzliar.jp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (未設定の場合はモック決済モードで動作 = 実課金なしで即確定)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# メール送信 (Resend。未設定の場合はメール送信をスキップ)
RESEND_API_KEY=
EMAIL_FROM="PUZZLIAR チケット <tickets@puzzliar.jp>"

# Vercel Cron の保護用(任意)
CRON_SECRET=

# ---- 稽古・シフト管理 (docs/rehearsal-requirements.md) ----
# LINE Messaging API (LINE Developers > Messaging API チャネル)。未設定時は LINE 通知をスキップしメールにフォールバック
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 公式アカウントの友だち追加URL (https://lin.ee/xxxx)。/me 画面に表示
LINE_ADD_FRIEND_URL=
# 定時通知 (/api/cron/rehearsal-notify を外部スケジューラから10〜30分おきに呼ぶ)。JSTの「時」
REHEARSAL_DIGEST_HOUR=8
REHEARSAL_REMINDER_HOUR=20
# Google Calendar API 連携 (Google Cloud Console > OAuth 2.0 クライアント。リダイレクトURI: {NEXT_PUBLIC_SITE_URL}/api/google/callback)
# 未設定時は iCal 購読のみ提供
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# リフレッシュトークン暗号化鍵(任意の長い文字列。未設定時は SUPABASE_SERVICE_ROLE_KEY から導出)
GOOGLE_TOKEN_KEY=

# ---- 共通アカウント基盤 / 稽古管理 v0.2 ----
# 組織作成を招待制にする(既定)。一般公開時に true
ORG_CREATION_OPEN=false
# LINE ログイン(任意。LINE Developers の同一プロバイダー配下に Messaging API チャネルと一緒に作る)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_LOGIN_ENABLED=false
# LINE プッシュの月間全体上限(無料プランの無料枠に合わせる)
LINE_PUSH_MONTHLY_LIMIT=200
# Web プッシュ(VAPID)。`npx web-push generate-vapid-keys` で生成
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@puzzliar.jp
